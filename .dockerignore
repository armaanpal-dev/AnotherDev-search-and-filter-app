# Anything here is excluded from the Docker build context.
#
# .env FIRST and foremost: the Dockerfile does `COPY . .`, so without this line
# the real Supabase password and SHOPIFY_API_SECRET are baked into an image
# layer. Runtime config comes from `fly secrets`, never from a file in the image.
.env
.env.*
!.env.example

# Version control and local tooling state.
.git
.gitignore
.github
.shopify
.claude

# Build output — the image builds its own inside the container.
.cache
build
node_modules
.react-router
extensions/*/dist

# Not needed to run the server.
test
*.md
!README.md
