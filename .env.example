# --- Shopify -----------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Read-only throughout: the app mirrors the catalog and never writes to the store.
SCOPES=read_products,read_product_listings,read_collection_listings,read_inventory,read_content

# --- Database ----------------------------------------------------------------
# Runtime uses the pooled connection; migrations and DDL use the direct one.
# On Supabase: DATABASE_URL = Transaction pooler (6543), DIRECT_URL = Direct (5432).
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/anotherdev_search?schema=public"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/anotherdev_search?schema=public"

# --- Search backend ----------------------------------------------------------
SEARCH_BACKEND=postgres

# How long facet aggregates are reused. Facets are the expensive half of a
# search, and they do not change between pages or sorts of the same query.
FACET_CACHE_TTL_MS=20000

# --- Semantic search (optional) ----------------------------------------------
# Off by default: keyword search is complete without it. Turning it on adds an
# embeddings API call per new/changed product and per uncached query, and needs
# pgvector in Postgres. Pro plan only.
SEMANTIC_SEARCH_ENABLED=false
EMBEDDINGS_PROVIDER=voyage        # voyage | openai
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDINGS_MODEL=voyage-3.5-lite

# --- Billing -----------------------------------------------------------------
# Test charges are approved in the admin but never billed. Leave unset to infer
# from NODE_ENV; set explicitly so a deploy that forgets NODE_ENV=production
# cannot silently issue charges that never take a payment.
SHOPIFY_BILLING_TEST=false

# --- Analytics ---------------------------------------------------------------
# Raw search events kept this long. Pruned opportunistically after each catalog
# sync; a little beyond the 90-day Pro window so an upgrade shows history at once.
ANALYTICS_RETENTION_DAYS=180

# How long the anonymous storefront session token stays on a search event. It is
# only needed to attribute a click or add-to-cart back to its search (a 2-hour
# window), so it is cleared a day later and the retained analytics hold no
# per-shopper identifier at all.
ANALYTICS_SESSION_TOKEN_RETENTION_HOURS=24

# --- Local dev only ----------------------------------------------------------
# SHOP_CUSTOM_DOMAIN=
