{% comment %}
  AnotherDev Search — full results grid with faceted filters, sort, pagination.
  Add this app block to your Search template (or a dedicated page) in the theme editor.
  It reads ?q= from the URL and renders instantly from the app proxy JSON API.
{% endcomment %}

<div
  class="adsf-app"
  data-adsf-results-app
  data-proxy="{{ block.settings.proxy_base | default: '/apps/anotherdev-search' }}"
  data-per-page="{{ block.settings.per_page | default: 24 }}"
  data-collection="{{ block.settings.collection_scope }}"
  style="--adsf-accent: {{ block.settings.accent_color }}; --adsf-cols: {{ block.settings.columns | default: 4 }};"
>
  <div class="adsf-app__topbar">
    <button type="button" class="adsf-app__filter-toggle" data-adsf-filter-toggle aria-expanded="false">
      Filters
    </button>
    <div class="adsf-app__meta" data-adsf-meta aria-live="polite"></div>
    <label class="adsf-app__sort">
      <span class="adsf-visually-hidden">Sort by</span>
      <select data-adsf-sort>
        <option value="relevance">Relevance</option>
        <option value="price_asc">Price: Low to High</option>
        <option value="price_desc">Price: High to Low</option>
        <option value="newest">Newest</option>
        <option value="bestselling">Best selling</option>
        <option value="title_asc">Alphabetical</option>
      </select>
    </label>
  </div>

  <div class="adsf-app__body">
    <aside class="adsf-facets" data-adsf-facets aria-label="Filters">
      <div class="adsf-facets__inner" data-adsf-facets-inner></div>
    </aside>

    <div class="adsf-app__main">
      {% comment %} Reserve space to avoid layout shift while first results load. {% endcomment %}
      <div class="adsf-grid" data-adsf-grid aria-busy="true"></div>
      <div class="adsf-pagination" data-adsf-pagination></div>
    </div>
  </div>

  <div class="adsf-drawer-backdrop" data-adsf-backdrop hidden></div>
</div>

{{ 'anotherdev-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'anotherdev-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AnotherDev Search Results",
  "target": "section",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" },
    { "type": "range", "id": "columns", "label": "Grid columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "collection_scope", "label": "Scope to collection (handle)", "info": "Leave blank for site-wide search." },
    { "type": "text", "id": "proxy_base", "label": "App proxy base path", "default": "/apps/anotherdev-search" }
  ]
}
{% endschema %}
