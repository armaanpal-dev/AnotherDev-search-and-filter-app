{% comment %}
  AnotherDev Search — APP EMBED (target: body).
  Enabling this activates instant search on the storefront. ALL appearance and
  behaviour settings live in the app (AnotherDev Search → Settings) and are loaded
  live from the app, so there's nothing to configure here.
{% endcomment %}

<script>
  window.ADSF_CONFIG = {
    proxy: "/apps/anotherdev-search",
    resultsUrl: "/apps/anotherdev-search/results",
    autoAttach: true,
    {% comment %}
      The shop's money format and the active market's rate. Prices are indexed in
      the shop's own currency, so a shopper browsing in another market has to see
      the converted amount in that market's format — not the raw stored number
      rendered with the browser's locale.
    {% endcomment %}
    moneyFormat: {{ shop.money_format | json }},
    shopCurrency: {{ shop.currency | json }}
  };
</script>

{{ 'anotherdev-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'anotherdev-search.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AnotherDev Search",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "AnotherDev Search & Filters"
    },
    {
      "type": "paragraph",
      "content": "Enabled! Instant search is now live on your storefront, including your theme's own search box and search page. Configure the look and behaviour — panel style, colors, fonts, recommendations, hover preview — inside the AnotherDev Search app under Settings. Changes apply automatically."
    }
  ]
}
{% endschema %}
