// AnotherDev Search & Filters — data model
// Postgres is the single datastore: it holds app config AND the search index.
// Full-text (tsvector), fuzzy (pg_trgm) and accent-insensitive (unaccent) search
// columns/indexes are added by a follow-up raw-SQL migration because Prisma does
// not model those Postgres types natively. See prisma/migrations/*_search_index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime uses the pooled connection; migrations use the direct one.
  // On Supabase: url = Transaction pooler (6543), directUrl = Direct (5432).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Shopify session storage (required by @shopify/shopify-app-session-storage-prisma) ---
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// --- One row per installed store ---
model Shop {
  id           String   @id @default(cuid())
  domain       String   @unique // foo.myshopify.com
  name         String?
  currencyCode String?
  // Plan resolved from Shopify billing on every admin visit and by the
  // app_subscriptions/update webhook. Never edit this by hand: it is
  // overwritten. Use planOverride instead.
  planName     String   @default("free")
  // Manual override, set by an operator rather than by billing. When present
  // it wins over whatever Shopify reports, which is how a shop gets a paid
  // tier without a charge (an agency client, a partner, a long trial). Clear
  // it to hand control back to billing.
  planOverride String?
  installedAt  DateTime @default(now())
  uninstalledAt DateTime?

  // JSON blob of merchant-tunable settings (widget theming, enabled filters, CRO toggles…)
  settings     Json     @default("{}")
  onboarded    Boolean  @default(false)
  // Set the first time the merchant completes the three setup steps, so the
  // dashboard can stop nagging. `onboarded` alone was written by nothing.
  onboardedAt  DateTime?
  // Last time old SearchEvent rows were pruned for this shop.
  analyticsPrunedAt DateTime?

  // Postgres text-search configuration used for stemming. "simple" does no
  // stemming at all (the safe default for a mixed or unknown catalog); a real
  // language config makes "boots" find "boot". Validated against
  // SEARCH_LANGUAGES in app/lib/search/languages.ts before it reaches SQL.
  searchLanguage String @default("simple")

  // Nightly catalog reconciliation. Webhooks miss edits (bulk edits, apps
  // writing through the API, a dropped delivery), and a merchant will not
  // re-sync by hand — so the index quietly drifts without this.
  autoSyncEnabled Boolean   @default(true)
  lastAutoSyncAt  DateTime?

  products      Product[]
  collections   Collection[]
  pages         Page[]
  synonyms      Synonym[]
  redirects     Redirect[]
  rules         MerchandisingRule[]
  searchEvents  SearchEvent[]
  syncState     SyncState?
  filterConfig  FilterConfig[]
  presets       FilterPreset[]

  updatedAt    DateTime @updatedAt
}

// --- Collections mirror (for the autocomplete "Collections" section) ---
model Collection {
  id           String  @id @default(cuid())
  shopId       String
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionId String  // Shopify GID numeric part
  handle       String
  title        String
  imageUrl     String?
  productCount Int     @default(0)
  indexedAt    DateTime @default(now())

  @@unique([shopId, collectionId])
  @@index([shopId])
}

// --- Pages mirror (for the autocomplete "Pages" section) ---
model Page {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pageId    String   // Shopify GID numeric part
  handle    String
  title     String
  indexedAt DateTime @default(now())

  @@unique([shopId, pageId])
  @@index([shopId])
}

// --- Product mirror (the search index) ---
// Denormalised for fast reads. `searchDocument`/`searchVector` are populated by
// the raw-SQL migration; Prisma just reserves the plain columns it can model.
model Product {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId    String   // Shopify GID numeric part, e.g. "81234567890"
  handle       String
  title        String
  description  String   @default("")
  vendor       String   @default("")
  productType  String   @default("")
  tags         String[] @default([])
  status       String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  available    Boolean  @default(true)

  priceMin     Float    @default(0)
  priceMax     Float    @default(0)
  currencyCode String   @default("")
  imageUrl     String?
  imageAlt     String?

  // Structured option values for faceting, e.g. { "Color": ["Red","Blue"], "Size": ["S","M"] }
  options      Json     @default("{}")
  // Collections this product belongs to (handles) for collection-scoped search/merchandising
  collections  String[] @default([])
  // Free-form numeric/text metafields surfaced as filters
  metafields   Json     @default("{}")

  // Flattened variant titles + SKUs, folded into the search vector so shoppers
  // and staff can find a product by SKU or by a variant name ("red medium").
  variantText  String   @default("")
  skus         String[] @default([])

  // Published to the Online Store sales channel. An ACTIVE product that is not
  // published has no storefront URL — indexing it produces 404s in results.
  publishedOnline Boolean @default(true)

  // Popularity signal for tie-breaking / boosting (orders, views…)
  popularity   Float    @default(0)
  // Last time popularity decay was applied to this row.
  popularityDecayedAt DateTime?
  // Set when the pgvector embedding for this row was last written; null = stale.
  embeddedAt   DateTime?

  // The Postgres text-search configuration this row's `searchVector` was built
  // with, mirrored from Shop.searchLanguage. It lives on the row (not read from
  // Shop at query time) because `searchVector` is a STORED generated column: the
  // config has to be an immutable input to the generation expression.
  tsConfig     String   @default("simple")

  publishedAt  DateTime?
  productUpdatedAt DateTime? // updatedAt from Shopify
  indexedAt    DateTime @default(now())

  variants     ProductVariant[]

  @@unique([shopId, productId])
  @@index([shopId, status, available])
  @@index([shopId, status, publishedOnline, available])
  @@index([shopId, handle])
  @@index([shopId, embeddedAt])
  // Browse and "best selling" order by these with no text predicate to narrow
  // the set first, so without an index every unfiltered collection page sorts
  // the whole catalog.
  @@index([shopId, popularity])
  @@index([shopId, publishedAt])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId   String  // Shopify variant GID numeric part
  title       String  @default("")
  sku         String  @default("")
  price       Float   @default(0)
  available   Boolean @default(true)
  // Selected option values, e.g. { "Color": "Red", "Size": "M" }
  optionValues Json   @default("{}")

  @@unique([productId, variantId])
  @@index([productId])
}

// --- Merchant-configured relevance & routing ---
model Synonym {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // "multiway": all terms are interchangeable. "oneway": `input` maps to `terms`.
  type      String   @default("multiway")
  input     String?  // used only for oneway
  terms     String[] @default([])
  createdAt DateTime @default(now())

  @@index([shopId])
}

model Redirect {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  query     String   // normalised search term that triggers the redirect
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, query])
  @@index([shopId])
}

model MerchandisingRule {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean  @default(true)
  // Trigger: a search query and/or a collection handle. Null = applies globally.
  triggerQuery      String?
  triggerCollection String?
  // Actions
  pinnedProductIds  String[] @default([]) // force to top, in order
  boostedProductIds String[] @default([]) // rank higher
  buriedProductIds  String[] @default([]) // rank lower
  hiddenProductIds  String[] @default([]) // remove from results
  // Attribute-driven actions, so a merchant can say "boost anything tagged
  // new-arrival" instead of pasting product ids. Shape:
  //   [{ field: "tag"|"vendor"|"productType"|"collection"|"available"|"option:Color",
  //      op: "eq"|"neq"|"contains", value: "new-arrival",
  //      action: "boost"|"bury"|"hide"|"pin", weight: 5 }]
  conditions Json     @default("[]")
  priority   Int      @default(0)
  // Scheduling window. A sale rule that has to be switched on and off by hand at
  // midnight is a rule that gets left on. Null on either side means unbounded.
  startsAt   DateTime?
  endsAt     DateTime?
  // A/B bucket this rule applies to: "all", "a" or "b". Shoppers are assigned a
  // stable bucket from their session token, so two merchandising strategies can
  // run side by side and be compared in Analytics.
  variant    String   @default("all")
  createdAt  DateTime @default(now())

  @@index([shopId, active])
}

/**
 * A one-click filter shortcut ("Under $50", "New in"), rendered as a row of
 * chips above the facets. It is just a saved query string, so it can express
 * anything the URL can — including combinations no single facet offers.
 */
model FilterPreset {
  id       String  @id @default(cuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  label    String
  // Shopper-facing query fragment, e.g. `price.max=50` or `f.tag=new&sort=newest`.
  params   String
  position Int     @default(0)
  enabled  Boolean @default(true)

  @@index([shopId, enabled])
}

model FilterConfig {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Which attribute this facet exposes: "price" | "vendor" | "productType" | "tag" | "option:Color" | "metafield:material"
  source    String
  label     String
  // "checkbox" | "range" | "swatch" | "list"
  displayAs String   @default("checkbox")
  position  Int      @default(0)
  enabled   Boolean  @default(true)

  @@unique([shopId, source])
  @@index([shopId, enabled])
}

// --- Analytics ---
model SearchEvent {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  query         String
  normalized    String   @default("")
  resultsCount  Int      @default(0)
  clickedProductId String?
  converted     Boolean  @default(false)
  // Set by the Web Pixel when an order containing a searched-for product is
  // completed. Checkout runs on Shopify's domain, so this is the only way to
  // close the loop from a search to money.
  purchased     Boolean  @default(false)
  revenue       Float?
  orderId       String?
  // A/B bucket this shopper was in, so Analytics can compare two rule sets.
  bucket        String?
  sessionToken  String?  // anonymous storefront session for CTR/CVR joins
  createdAt     DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, normalized])
  // The attribution lookup in proxy/track filters on all three and orders by
  // createdAt. Without this it scanned every event the shop ever recorded.
  @@index([shopId, sessionToken, createdAt])
}

// --- Sync bookkeeping ---
model SyncState {
  id           String   @id @default(cuid())
  shopId       String   @unique
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status       String   @default("idle") // idle | running | error
  lastSyncAt   DateTime?
  lastCursor   String?
  bulkOpId     String?
  productCount Int      @default(0)
  // Live progress for the sync animation.
  phase        String   @default("idle") // idle | exporting | indexing | done | error
  // Heartbeat written throughout a run. A "running" state whose heartbeat has
  // gone quiet is a crashed run, not a live one.
  startedAt    DateTime?
  heartbeatAt  DateTime?
  progressCurrent Int   @default(0)
  progressTotal   Int   @default(0)
  message      String?

  // Attribute names discovered during the last sync, cached here so the Filters
  // and Merchandising pages can offer them without running
  // `SELECT DISTINCT jsonb_object_keys(...)` — a full scan of Product — on every
  // page load.
  optionNames    String[] @default([])
  metafieldKeys  String[] @default([])

  updatedAt    DateTime @updatedAt
}
